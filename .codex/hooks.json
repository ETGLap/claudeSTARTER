{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/malamutlemit/Desktop/Projects/Application/claudeSTARTER/.codex/hooks/guard-writes.js'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/malamutlemit/Desktop/Projects/Application/claudeSTARTER/.codex/hooks/guard-bash.js'",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/malamutlemit/Desktop/Projects/Application/claudeSTARTER/.codex/hooks/format.js'",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node '/Users/malamutlemit/Desktop/Projects/Application/claudeSTARTER/.codex/hooks/spec-session.js'",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/malamutlemit/Desktop/Projects/Application/claudeSTARTER/.codex/hooks/context-inject.js'",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/malamutlemit/Desktop/Projects/Application/claudeSTARTER/.codex/hooks/test-gate.js'"
          },
          {
            "type": "command",
            "command": "node '/Users/malamutlemit/Desktop/Projects/Application/claudeSTARTER/.codex/hooks/notify.js' stop"
          }
        ]
      }
    ]
  }
}
